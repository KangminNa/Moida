# Moida 설정. 복사해서 .env로 쓰세요: cp .env.example .env
# 블로그 이름 · 사이트 주소 · 플러그인 · AI 토큰은 여기가 아니라 설치 화면 · 콘솔에서 정해요
# 옛 이름(CAIRN_*)으로 적은 .env도 그대로 돈다 (2026-11-28 이름 cairn → moida). 서버가 시작할 때 옛 이름을 알리면 MOIDA_로 바꿔 주세요.
# DB 사용자 · 이름은 이미 만든 DB를 그대로 쓰도록 기본이 cairn이다 (바꾸려면 MOIDA_DB_USER · MOIDA_DB_NAME, 새로 설치할 때만)
#
# ── 빠른 시작: 아래 넷 중 하나를 골라 그 묶음의 # 를 지우고 값을 채운다 ──────────────────────
#
# [A] 내 컴퓨터에서 개발 · 시험 (pnpm dev)
#     이 파일 그대로 두고 MOIDA_SECRET_KEY만 채우면 된다 (pnpm secret:new 결과)
#     브라우저까지 켜려면:
#       COMPOSE_FILE=docker-compose.yml:docker-compose.browser.yml
#     화면은 콘솔(운영 › 브라우저 › 화면 열기)에서 본다
#
# [B] 서버: 블로그 · 콘솔 · AI 연결만
#       COMPOSE_FILE=docker-compose.prod.yml
#       DB_PASSWORD=<긴 임의 값>
#       MOIDA_SECRET_KEY=<pnpm secret:new 또는 openssl rand -base64 32>
#       MOIDA_WEB_URL=https://내블로그주소   (https면 로그인 쿠키는 늘 https 전용(Secure): 앞단 프록시가 https를 알리지 않아도)
#
# [C] 서버: B + 페이지 · PPT · 문서 만들기 (만들기 일은 코드 러너 칸에서만 돈다. 없으면 일이 "대기"에 머문다)
#       COMPOSE_FILE=docker-compose.prod.yml:docker-compose.code.yml
#       (나머지는 B와 같다. 칸 하나가 메모리를 최대 4GB까지 쓴다)
#
# [D] 서버: C + 서버 브라우저 (README 설치 6. 화면은 콘솔에서 HTTPS로 본다: 따로 여는 포트 · 비밀번호가 없다)
#       COMPOSE_FILE=docker-compose.prod.yml:docker-compose.code.yml:docker-compose.browser.yml
#       (나머지는 B와 같다. ARM 서버도 그대로. 브라우저가 메모리를 0.3~1GB 더 쓴다)
#
# 서버의 3000 · 4000 포트를 이미 다른 프로그램이 쓰면 WEB_PORT · SERVER_PORT를 바꾸고, 앞단 프록시도 그 포트로 넘긴다
# 앞단 프록시가 Docker 컨테이너면 docker-compose.override.yml로 그 네트워크에 붙이고 COMPOSE_FILE 끝에 :docker-compose.override.yml (README 설치 2)
#   그 프록시는 웹을 moida-web:3000으로 부른다 (컨테이너 안 포트는 WEB_PORT와 상관없이 늘 3000)
# ──────────────────────────────────────────────────────────────────────────────────

# 쓸 compose 파일들. 비워 두면 개발 구성(docker-compose.yml). 서버는 위 B · C · D 중 하나
# COMPOSE_FILE=docker-compose.prod.yml
# 파일 여럿을 :로 잇는다. Windows는 기본 구분자가 ;라서 이 줄이 있어야 :가 먹는다 (Linux · Mac에서도 그대로 둬도 된다)
COMPOSE_PATH_SEPARATOR=:

# DB 비밀번호. 서버에 올릴 때는 긴 임의 값으로 (DB를 처음 만들 때 정해져서 나중에 바꾸면 맞지 않아요)
DB_PASSWORD=moida
DB_PORT=5432

# 서버(API)와 웹 포트. DB · 서버 · 웹 모두 이 컴퓨터(127.0.0.1)에서만 열린다 (밖에는 https 프록시만)
SERVER_PORT=4000
WEB_PORT=3000

# 서버 키: 비밀값(플러그인 토큰 등)을 DB에 암호화해 넣을 때 쓴다. 설치 때 한 번 만든다
#   만들기: pnpm secret:new  (node가 없으면 openssl rand -base64 32)
#   잃어버리면 저장된 비밀값을 다시 넣어야 해요. DB 백업과 함께 따로 보관한다
MOIDA_SECRET_KEY=

# 사람이 여는 웹 주소. 서버에 올렸으면 꼭 https://내블로그주소
#   설치 코드 안내 · 푸시 연락처에 쓰고, 개발 모드 웹은 이 주소에서 연 화면만 동작하게 한다 (다르면 버튼이 눌리지 않아요)
#   비워 두면 http://localhost:<WEB_PORT>
# MOIDA_WEB_URL=
#   앱 도메인을 로컬 개발 서버에서 열 때는 <이름>.test로 정하고 hosts 파일에 127.0.0.1로 적는다 (localhost는 앱 도메인으로 받지 않는다).
#   .test가 아닌 이름은 여기에 쉼표로 더한다 (개발 서버에서만 쓴다. 빠지면 그 도메인의 회원 화면이 눌리지 않아요)
# MOIDA_DEV_ORIGINS=

# 공통 앱 도메인 (2026-11-27): 앱을 여는 도메인 하나. 예: https://apps.moida.ai.kr
#   앱은 <이 주소>/<앱>/…에서 콘솔과 다른 출처로 열려 격리 없이 돌고(지도 키 · 바깥 이미지), 회원은 한 번 로그인하면 모든 앱에 같은 쿠키로 참여한다.
#   이 도메인의 / 는 스토어 첫 화면, 콘솔 · 로그인 · 설치는 MOIDA_WEB_URL로 넘어간다. 기본 도메인의 / 와 앱 주소는 이 도메인으로 넘어간다 (308).
#   앞단 프록시(Caddy)에 이 도메인도 웹으로 넘기게 적는다 (/api는 서버로). 자기 도메인을 연결한 앱은 그 도메인이 그대로 먼저다.
#   비워 두면 지금처럼 기본 도메인의 /<앱> (콘솔과 같은 출처라 격리)
# MOIDA_APPS_URL=

# ── 결과물 한도 ────────────────────────────────────────────────────────────────────
# AI가 작업에서 만든 파일의 한도. 공간 전체 GB, 디스크에 늘 남길 GB (DB가 디스크가 차서 멈추지 않게)
#   서버 기본은 80 · 20 (디스크 200GB 기준), 개발 구성은 80 · 5. 모자라면 늘리거나, 나중에 클라우드 저장소로 옮긴다
# MOIDA_OUTPUTS_MAX_GB=80
# MOIDA_DISK_RESERVE_GB=20

# ── 가끔만 쓰는 것 ──────────────────────────────────────────────────────────────────
# 서버 키를 바꿀 때만. 순서:
#   1. 지금 키를 MOIDA_SECRET_KEY_OLD로 옮기고, MOIDA_SECRET_KEY에 새 키를 넣는다
#   2. docker compose up -d   (서버 · 일꾼이 새 키로 쓰고, 옛 키로 잠긴 값도 읽는다)
#   3. pnpm secret:rotate     (node가 없으면 docker compose exec -T server moida-admin secret rotate)
#      저장된 비밀값을 새 키로 다시 암호화한다. 두 번 돌려도 안전하고, 풀리지 않는 값이 있으면 멈춘다
#   4. MOIDA_SECRET_KEY_OLD를 지우고 docker compose up -d
#   키를 바꾸면 설치 코드가 바뀌고, 진행 중인 기기 승인 · 설치 · 외부 로그인은 처음부터 다시 해야 해요.
#   브라우저 푸시도 콘솔의 알림 메뉴에서 브라우저마다 "다시 켜기"를 눌러야 해요
# MOIDA_SECRET_KEY_OLD=

# 브라우저 푸시: 따로 할 일 없음. 서버 키에서 키를 만들고, 알려진 푸시 서비스(크롬 · 파이어폭스 · 사파리 · 엣지)로만 보낸다
#   직접 운영하는 푸시 서비스가 있을 때만 그 출처를 쉼표로
# MOIDA_PUSH_EXTRA_ORIGINS=https://push.example.com

# 서버 러너: 서버와 함께 뜨고 스스로 연결한다 (할 일 없음). 콘솔의 AI 메뉴에 토큰을 넣으면 일한다
#   동시에 하는 일의 수 (1~8, 기본 3). 늘리면 구독 사용량이 그만큼 빨리 찬다 (닿으면 새 일을 쉬는 규칙은 그대로)
# MOIDA_RUNNER_CONCURRENCY=3
# 실행 기록에 남는 러너 빌드 이름 (빌드할 때 git rev-parse --short HEAD, 비우면 unknown)
# MOIDA_RUNNER_BUILD=
#   같은 대화 · 목표 실행의 다음 일은 앞 실행의 CLI 세션을 이어서 한다 (Claude만, 24시간 · 50개, 설정 없음).
#   서버 러너의 세션 파일은 컨테이너 안 /tmp(compose의 MOIDA_RUNNER_LINEAGES_DIR)에만 있어 다시 띄우면 사라진다:
#   그때는 인수인계 메모로 이어 간다
#   러너가 사라지면 그 일은 2분 안에 다른 러너가 이어 받는다 (작업 점유 시간)
# 내 컴퓨터에서 러너를 돌리는 법은 apps/runner/.env.example

# 이미지 태그: moida-app · moida-web · moida-db 등 이미지 이름 뒤에 붙는다 (기본 dev).
#   pnpm slot이 슬롯마다 s<번호>로 정한다. 서버에서 버전마다 이미지를 남겨 두고 되돌릴 때만 바꾼다
# MOIDA_IMAGE_TAG=dev
