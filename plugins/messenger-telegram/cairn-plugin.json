{
  "name": "messenger-telegram",
  "version": "0.1.0",
  "cairn": ">=0.10",
  "description": "텔레그램 봇으로 대표에게 말하고 답을 받는다. 콘솔에서 받은 연결 코드를 봇에게 보낸 계정의 말만 받고, 승인은 그대로 콘솔에서 한다",
  "schema": "telegram",
  "server": "server/plugin.ts",
  "settings": {
    "token": {
      "label": "봇 토큰",
      "type": "secret",
      "required": true,
      "help": "텔레그램 @BotFather에서 /newbot으로 만든 봇의 토큰"
    },
    "siteUrl": {
      "label": "이 Moida의 바깥 주소",
      "type": "text",
      "required": true,
      "help": "https://로 시작하는 주소 (예: https://blog.example.com). 텔레그램이 이 주소로 메시지를 보내고, 답장의 링크도 이 주소예요"
    },
    "apiUrl": {
      "label": "텔레그램 API 주소",
      "type": "text",
      "default": "https://api.telegram.org",
      "help": "직접 띄운 Bot API 서버를 쓸 때만 바꿔요"
    }
  },
  "api": {
    "POST /hook/:key": "receive",
    "GET /links": "listLinks",
    "POST /pairings": "createPairing",
    "POST /links/:id/unlink": "unlink"
  },
  "menu": {
    "group": "운영",
    "name": "텔레그램",
    "icon": "chat",
    "page": "web/TelegramPage.tsx"
  },
  "uses": [
    "table",
    "api",
    "menu",
    "chat",
    "action:connect",
    "event:task.chat.said",
    "event:task.approval.requested",
    "event:plugin.telegram.*"
  ]
}
