          "wait_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "required": ["run_id"]
      }
    },
    "site_run_next": {
      "polled": true,
      "operation": "nextRun",
      "description": "기다리는 사이트 도구 실행 하나를 꺼낸다 (서버 브라우저가 있는 러너). 코드 · 입력 · 읽기/쓰기(mode) · 사이트(허용 출처)가 오고, 러너가 AI 없이 돌려 site_run_save로 남긴다. 읽기는 90초 안에 남기지 않으면 다시 줄을 서고, 쓰기는 다시 하지 않는다(눌렸는지 모름). 없으면 run: null.",
      "input": {
        "properties": {}
      }
    },
